# ============================================
# KOOK AI 群酒馆 / 轻量文字冒险引擎配置模板
# 复制本文件为 .env 并填入你的密钥
# ============================================

# --- KOOK 开放平台机器人配置 ---
# 前往 https://developer.kookapp.cn 创建应用 -> 机器人 -> 选择 WebSocket 连接模式 -> 复制 Token
KOOK_BOT_TOKEN=

# --- 大模型 API 配置（兼容任意 OpenAI Chat Completions 接口） ---
# 示例：
#   DeepSeek:   https://api.deepseek.com/v1       (model: deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1      (model: google/gemini-2.5-flash)
#   OpenAI:     https://api.openai.com/v1         (model: gpt-4o-mini)
#   本地 Ollama: http://127.0.0.1:11434/v1        (model: qwen2.5:14b)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：用于章节自动摘要的轻量模型（留空则复用 LLM_MODEL）
LLM_SUMMARY_MODEL=

# 大模型温度与最大输出 Token
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=2048

# --- 游戏引擎与存储配置 ---
DB_PATH=data/tavern.db
SCENARIOS_DIR=scenarios
PROMPTS_DIR=prompts
EXPORTS_DIR=exports

# 短期记忆保留最近多少轮完整对话（超出部分自动滚动压缩为前情提要）
RECENT_TURNS_WINDOW=8
# 每隔多少轮触发一次后台摘要压缩
SUMMARY_INTERVAL_TURNS=6
# 当所有已入团玩家都提交行动后，是否自动结算本轮（true/false）
AUTO_RESOLVE_ALL_READY=true

# --- M1 安全防线与预算熔断（强烈建议上云后填写） ---
# 亲友服白名单（逗号分隔的 KOOK 服务器 ID，留空则不限制）
ALLOWED_GUILD_IDS=
# 可选：进一步限制仅允许指定频道 ID（留空则允许白名单服务器内所有频道）
ALLOWED_CHANNEL_IDS=
# 管理员用户 ID（逗号分隔；执行 /reload 热重载剧本必须显式配置，同时也可使用 /gm、/reset 等管理指令）
ADMIN_USER_IDS=
# 可选：冒险战报墙频道 ID（留空则仅本地导出，填写后 /export 或点「发战报墙」会自动同步发精美战报卡）
EXPORT_CHANNEL_ID=
# 可选：M2 只读伴生 Web 看板监听地址（留空则关闭 Web 看板；严禁使用 8080/3000/6099）
WEB_BIND_ADDR=0.0.0.0:8787
# 可选：对外展示的 Web 看板访问前缀（如 http://你的公网IP或域名:8787，用于 KOOK /web 拼链接）
WEB_PUBLIC_BASE_URL=
# 每日全局最大 LLM 调用次数（0 表示不限制）
DAILY_MAX_LLM_CALLS=200
# 每日全局最大预估花费（人民币元，0 表示不限制）
DAILY_MAX_CNY=20.0
# DeepSeek V3/chat 默认估算单价（元 / 百万 Tokens，仅用于 /cost 估算与熔断）
PRICE_CACHE_HIT_CNY_PER_M=0.2
PRICE_CACHE_MISS_CNY_PER_M=2.0
PRICE_OUTPUT_CNY_PER_M=3.0

# 日志级别（保留 warn 兜底 + 放行全工作区 tavern_* 日志）
RUST_LOG=warn,kook_tavern_dm=info,tavern_=info
