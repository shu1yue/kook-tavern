# ============================================
# KOOK AI 群酒馆 / 轻量文字冒险引擎配置模板
# 复制本文件为 .env 并填入你的密钥
# ============================================

# --- KOOK 开放平台机器人配置 ---
# 前往 https://developer.kookapp.cn 创建应用 -> 机器人 -> 选择 WebSocket 连接模式 -> 复制 Token
KOOK_BOT_TOKEN=

# --- 大模型 API 配置（兼容任意 OpenAI Chat Completions 接口） ---
# 示例：
#   DeepSeek:   https://api.deepseek.com/v1       (model: deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1      (model: google/gemini-2.5-flash)
#   OpenAI:     https://api.openai.com/v1         (model: gpt-4o-mini)
#   本地 Ollama: http://127.0.0.1:11434/v1        (model: qwen2.5:14b)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：用于章节自动摘要的轻量模型（留空则复用 LLM_MODEL）
LLM_SUMMARY_MODEL=

# 大模型温度与最大输出 Token（DeepSeek 创意叙事推荐 1.15；保守控场可用 0.85）
LLM_TEMPERATURE=1.15
LLM_MAX_TOKENS=2048

# --- 游戏引擎与存储配置 ---
DB_PATH=data/tavern.db
SCENARIOS_DIR=scenarios
PROMPTS_DIR=prompts
EXPORTS_DIR=exports

# 短期记忆保留最近多少轮完整对话（超出部分自动滚动压缩为前情提要）
RECENT_TURNS_WINDOW=8
# 每隔多少轮触发一次后台摘要压缩
SUMMARY_INTERVAL_TURNS=6
# 当所有已入团玩家都提交行动后，是否自动结算本轮（true/false）
AUTO_RESOLVE_ALL_READY=true

# --- M1 安全防线与预算熔断（强烈建议上云后填写） ---
# 亲友服白名单（逗号分隔的 KOOK 服务器 ID，留空则不限制）
ALLOWED_GUILD_IDS=
# 可选：进一步限制仅允许指定频道 ID（留空则允许白名单服务器内所有频道）
ALLOWED_CHANNEL_IDS=
# 管理员用户 ID（逗号分隔；执行 /reload 热重载剧本必须显式配置，同时也可使用 /gm、/reset 等管理指令）
ADMIN_USER_IDS=
# 可选：冒险战报墙频道 ID（留空则仅本地导出，填写后 /export 或点「发战报墙」会自动同步发精美战报卡）
EXPORT_CHANNEL_ID=
# 可选：M2 只读伴生 Web 看板监听地址（留空则关闭 Web 看板；严禁使用 8080/3000/6099）
WEB_BIND_ADDR=0.0.0.0:8787
# 可选：对外展示的 Web 看板与悬浮 HUD 访问前缀（如 https://tavern.example.com，建议搭配 Cloudflare Tunnel 或 Nginx HTTPS）
WEB_PUBLIC_BASE_URL=
# 推荐：个人悬浮 HUD 的 HMAC-SHA256 独立签名密钥（建议用 `openssl rand -hex 32` 生成；留空则会派生自 Token）
HUD_SIGNING_SECRET=
# 每日全局最大 LLM 调用次数（0 表示不限制）
DAILY_MAX_LLM_CALLS=200
# 每日全局最大预估花费（人民币元，0 表示不限制）
DAILY_MAX_CNY=20.0
# DeepSeek V3/chat 默认估算单价（元 / 百万 Tokens，仅用于 /cost 估算与熔断）
PRICE_CACHE_HIT_CNY_PER_M=0.2
PRICE_CACHE_MISS_CNY_PER_M=2.0
PRICE_OUTPUT_CNY_PER_M=3.0

# --- 可选：v1.3 System One 潜意识反射层（Jev 决策门，留空则完全关闭、零耗时回退纯 Rust 规则） ---
# 阿里百炼 System One（推荐国内 ECS 直接使用，延迟 ~150ms）：
# 填入百炼 API Key 即可开启三项能力：
#   1) 群聊自由演绎模式自动放行场外吹水（不影响 /act、> 与私聊）
#   2) 隐藏世界书语义补漏（与原关键词触发取并集，100% 保持 DeepSeek Prefix Cache）
#   3) DM 结算语义质检（消除"幸好没受伤"误报 + 拦截私密纸条意外泄密到公开正文）
JEV_API_KEY=
JEV_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/systemone
JEV_MODEL=decision-model-preview
# 单次决策硬超时（毫秒，默认 2000ms，超时自动静默回退，绝不卡死跑团）
JEV_TIMEOUT_MS=2000
# 场外吹水拦截保守阈值（默认 0.85，越高越保守，防误吞正经动作）
JEV_OOC_THRESHOLD=0.85
# 隐藏世界书语义召回阈值（默认 0.72）
JEV_LORE_THRESHOLD=0.72
# DM 回复漏账/私密泄密质检阈值（默认 0.80）
JEV_AUDIT_THRESHOLD=0.80
# 可选：优先尝试 Google Decisions API（留空则仅用上方阿里百炼；若配置了失败时自动降级到百炼）
JEV_GOOGLE_ENDPOINT=
JEV_GOOGLE_API_KEY=
JEV_GOOGLE_PROXY_SECRET=
JEV_GOOGLE_MODEL=gemini-decision-1

# 日志级别（保留 warn 兜底 + 放行全工作区 tavern_* 日志）
RUST_LOG=warn,kook_tavern_dm=info,tavern_=info
