# ============================================
# KOOK AI 群酒馆 / 轻量文字冒险引擎配置模板
# 复制本文件为 .env 并填入你的密钥
# ============================================

# --- KOOK 开放平台机器人配置 ---
# 前往 https://developer.kookapp.cn 创建应用 -> 机器人 -> 选择 WebSocket 连接模式 -> 复制 Token
KOOK_BOT_TOKEN=

# --- 大模型 API 配置（兼容任意 OpenAI Chat Completions 接口） ---
# 示例：
#   DeepSeek:   https://api.deepseek.com/v1       (model: deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1      (model: google/gemini-2.5-flash)
#   OpenAI:     https://api.openai.com/v1         (model: gpt-4o-mini)
#   本地 Ollama: http://127.0.0.1:11434/v1        (model: qwen2.5:14b)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：用于章节自动摘要的轻量模型（留空则复用 LLM_MODEL）
LLM_SUMMARY_MODEL=

# 大模型温度与最大输出 Token
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=2048

# --- 游戏引擎与存储配置 ---
DB_PATH=data/tavern.db
SCENARIOS_DIR=scenarios
PROMPTS_DIR=prompts
EXPORTS_DIR=exports

# 短期记忆保留最近多少轮完整对话（超出部分自动滚动压缩为前情提要）
RECENT_TURNS_WINDOW=8
# 每隔多少轮触发一次后台摘要压缩
SUMMARY_INTERVAL_TURNS=6
# 当所有已入团玩家都提交行动后，是否自动结算本轮（true/false）
AUTO_RESOLVE_ALL_READY=true

# 日志级别（保留 warn 兜底 + 放行全工作区 tavern_* 日志）
RUST_LOG=warn,kook_tavern_dm=info,tavern_=info
